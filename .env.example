# Database Connection (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wehear?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="we-hear-insecure-dev-secret-change-in-production-min-32-chars-long"

# Google OAuth Credentials (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Indian Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WebRTC STUN & TURN Server Configuration
# STUN is freely provided by Google/public servers by default in code.
# For production TURN (e.g. Twilio Network Traversal, Metered, Coturn):
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# Application URLs & Support Contact
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SUPPORT_EMAIL="support.wehear@gmail.com"

# Session & Pricing Defaults (Configurable via Backend/Env)
SESSION_DURATION_MINUTES=30
CALL_PRICE_INR=20
LISTENER_EARNING_INR=15
MATCH_EXPIRATION_HOURS=24
